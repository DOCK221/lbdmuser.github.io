  {
    "id": "function-get-all-accounts",
    "type": "function",
    "z": "flow-bank-automation",
    "name": "Récupérer tous les comptes",
    "func": "const allAccounts = global.get('allAccounts') || {};\nconst totalBalance = global.get('totalBalance') || 0;\n\nmsg.payload = {\n    accounts: Object.values(allAccounts),\n    total: totalBalance,\n    timestamp: new Date()\n};\n\nreturn msg;",
