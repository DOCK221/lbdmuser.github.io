  {
    "id": "function-prepare-requests",
    "type": "function",
    "z": "flow-bank-automation",
    "name": "Préparer les requêtes",
    "func": "// Liste des comptes à interroger\nconst accounts = [\n    { id: 1, name: \"Compte Courant\" },\n    { id: 2, name: \"Livret A\" },\n    { id: 3, name: \"Compte Épargne\" },\n    { id: 4, name: \"Compte Joint\" }\n];\n\n// Créer un message pour chaque compte\nconst messages = accounts.map(account => ({\n    payload: {\n        accountId: account.id,\n        accountName: account.name,\n        url: `http://localhost:3000/api/account/${account.id}`\n    }\n}));\n\nreturn [messages];",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 110,
    "wires": [
      [
        "http-request-account"
      ]
    ]
  },
  {
    "id": "http-request-account",
    "type": "http request",
    "z": "flow-bank-automation",
    "name": "Requête API Bancaire",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "sendsPayload": false,
    "x": 630,
    "y": 110,
    "wires": [
      [
        "function-process-response"
      ]
    ]
  },
  {
    "id": "function-process-response",
    "type": "function",
    "z": "flow-bank-automation",
    "name": "Traiter les données",
    "func": "const accountData = msg.payload.account;\n\nmsg.payload = {\n    timestamp: new Date(),\n    accountId: accountData.id,\n    accountName: accountData.name,\n    bank: accountData.bank,\n    balance: accountData.balance,\n    currency: accountData.currency\n};\n\n// Sauvegarder dans le contexte global pour le dashboard\nconst allAccounts = global.get('allAccounts') || {};\nallAccounts[accountData.id] = msg.payload;\nglobal.set('allAccounts', allAccounts);\n\n// Calculer le total\nconst total = Object.values(allAccounts).reduce((sum, acc) => sum + acc.balance, 0);\nglobal.set('totalBalance', total);\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 890,
    "y": 110,
    "wires": [
      [
        "debug-output",
        "function-check-alert"
      ]
    ]
  },
  {
    "id": "debug-output",
    "type": "debug",
    "z": "flow-bank-automation",
    "name": "Log des comptes",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1140,
    "y": 80,
    "wires": []
  },
  {
    "id": "function-check-alert",
    "type": "function",
    "z": "flow-bank-automation",
    "name": "Vérifier alertes",
    "func": "const SEUIL_ALERTE = 1000;\n\nif (msg.payload.balance < SEUIL_ALERTE) {\n    msg.payload.alert = true;\n    msg.payload.message = `⚠️ Attention: Le solde du compte ${msg.payload.accountName} est inférieur à ${SEUIL_ALERTE}€ (${msg.payload.balance}€)`;\n    return msg;\n}\n\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1130,
    "y": 140,
    "wires": [
      [
        "debug-alert"
      ]
    ]
  },
